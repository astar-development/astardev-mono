<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AStarDev.CloudSync.UI.ViewModels"
             xmlns:views="using:AStarDev.CloudSync.UI.Views"
             xmlns:screens="using:AStarDev.CloudSync.UI.ViewModels.Screens"
             xmlns:loc="using:AStarDev.CloudSync.UI.Localisation"
             x:Class="AStarDev.CloudSync.UI.Views.Screens.ConflictsView"
             x:DataType="screens:ConflictsViewModel">
    <ScrollViewer>
        <StackPanel Margin="16" Spacing="12">
            <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary.Brush}" />
            <TextBlock Text="{loc:Loc Conflicts.ListHeading}" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary.Brush}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{loc:Loc Conflicts.SelectAll}" Click="OnSelectAll" />
                <Button Content="{loc:Loc Conflicts.ClearSelection}" Click="OnClearSelection" />
                <TextBlock Text="{Binding SelectedCountText}" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary.Brush}" />
            </StackPanel>
            <TextBlock Text="{loc:Loc Conflicts.Empty}" IsVisible="{Binding IsEmpty}" Foreground="{DynamicResource Text.Secondary.Brush}" />
            <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedConflict}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ConflictRowViewModel">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="12">
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Text.Primary.Brush}" />
                                <TextBlock Text="{Binding PathText}" Foreground="{DynamicResource Text.Secondary.Brush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding TypeText}" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary.Brush}" />
                            <TextBlock Grid.Column="3" Text="{Binding AgeText}" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary.Brush}" />
                            <views:StatusIndicatorView Grid.Column="4" DataContext="{Binding Status}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button Content="{loc:Loc Conflicts.More}" Command="{Binding LoadMoreCommand}" IsVisible="{Binding CanLoadMore}" />
            <Border BorderThickness="1" BorderBrush="{DynamicResource Border.Brush}" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="{loc:Loc Conflicts.NoDetail}" IsVisible="{Binding SelectedConflict, Converter={x:Static ObjectConverters.IsNull}}" Foreground="{DynamicResource Text.Secondary.Brush}" />
                    <ContentControl Content="{Binding SelectedConflict}"><ContentControl.ContentTemplate><DataTemplate x:DataType="vm:ConflictRowViewModel"><StackPanel Spacing="8">
                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary.Brush}" />
                        <TextBlock Text="{Binding TypeText}" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary.Brush}" />
                        <TextBlock Text="{Binding DetectedText}" Foreground="{DynamicResource Text.Secondary.Brush}" />
                        <TextBlock Text="{loc:Loc Conflicts.DetailHeading}" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary.Brush}" />
                        <TextBlock Text="{Binding ReasonText}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary.Brush}" />
                        <Grid ColumnDefinitions="Auto,*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="4">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Conflicts.Compare.Property}" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{loc:Loc Conflicts.Compare.Local}" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{loc:Loc Conflicts.Compare.Remote}" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Conflicts.Compare.Path}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LocalPath}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding RemotePath}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Conflicts.Compare.Modified}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LocalModifiedText}" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding RemoteModifiedText}" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Conflicts.Compare.Size}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LocalSizeText}" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding RemoteSizeText}" />
                        </Grid>
                    </StackPanel></DataTemplate></ContentControl.ContentTemplate></ContentControl>
                </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding Actions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ConflictActionViewModel">
                        <Button Content="{Binding Label}" IsEnabled="{Binding IsEnabled}" Tag="{Binding Choice}" Click="OnAction" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel IsVisible="{Binding IsConfirming}" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding ConfirmationText}" VerticalAlignment="Center" Foreground="{DynamicResource Text.Primary.Brush}" />
                <Button Content="{loc:Loc Conflicts.ConfirmYes}" Command="{Binding ConfirmCommand}" />
                <Button Content="{loc:Loc Conflicts.ConfirmNo}" Click="OnCancel" />
            </StackPanel>
            <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" Foreground="{DynamicResource Trust.Critical.Brush}" />
            <TextBlock Text="{Binding RecoveryText}" TextWrapping="Wrap" Foreground="{DynamicResource Trust.Healthy.Brush}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
