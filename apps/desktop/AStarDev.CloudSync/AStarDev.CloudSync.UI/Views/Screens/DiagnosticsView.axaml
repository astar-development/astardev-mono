<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AStarDev.CloudSync.UI.ViewModels.Screens"
             x:Class="AStarDev.CloudSync.UI.Views.Screens.DiagnosticsView"
             x:DataType="vm:DiagnosticsViewModel">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary.Brush}" />
        <Button DockPanel.Dock="Top" Margin="0,8,0,8" Content="{Binding RefreshText}" Command="{Binding RefreshCommand}" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" TextWrapping="Wrap" Foreground="{DynamicResource Trust.Degraded.Brush}" />
        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
            <TextBlock Foreground="{DynamicResource Text.Primary.Brush}">
                <Run Text="{Binding VersionLabel}" /><Run Text=": " /><Run Text="{Binding Version}" />
            </TextBlock>
            <TextBlock Foreground="{DynamicResource Text.Primary.Brush}">
                <Run Text="{Binding StateLabel}" /><Run Text=": " /><Run Text="{Binding State}" />
            </TextBlock>
            <TextBlock Foreground="{DynamicResource Text.Primary.Brush}">
                <Run Text="{Binding UptimeLabel}" /><Run Text=": " /><Run Text="{Binding Uptime}" />
            </TextBlock>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding ChecksLabel}" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary.Brush}" />
        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Checks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HealthCheckRowViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Text.Primary.Brush}" />
                            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Text.Secondary.Brush}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
