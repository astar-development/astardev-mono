<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AStarDev.CloudSync.UI.ViewModels.Screens"
             xmlns:svm="using:AStarDev.CloudSync.UI.ViewModels"
             xmlns:views="using:AStarDev.CloudSync.UI.Views"
             x:Class="AStarDev.CloudSync.UI.Views.Screens.QueueView"
             x:DataType="vm:QueueViewModel">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary.Brush}" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding ConflictsNote}" Foreground="{DynamicResource Text.Secondary.Brush}" TextWrapping="Wrap" Margin="0,8,0,0" />
        <StackPanel DockPanel.Dock="Top" IsVisible="{Binding HasDeadLetters}" Spacing="8" Margin="0,8,0,0">
            <TextBlock Text="{Binding DeadLettersHeading}" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary.Brush}" />
            <ItemsControl ItemsSource="{Binding DeadLetters}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DeadLetterRowViewModel">
                        <Border Classes="card" Margin="0,0,0,8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding TypeText}" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary.Brush}" />
                                <TextBlock Text="{Binding ItemText}" Foreground="{DynamicResource Text.Secondary.Brush}" />
                                <TextBlock Text="{Binding AttemptsText}" Foreground="{DynamicResource Text.Secondary.Brush}" />
                                <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" Foreground="{DynamicResource Trust.Degraded.Brush}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding DateText}" Foreground="{DynamicResource Text.Secondary.Brush}" />
                                    <TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource Text.Secondary.Brush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="{Binding $parent[UserControl].((vm:QueueViewModel)DataContext).RetryText}" Command="{Binding RetryCommand}" />
                                    <Button Content="{Binding $parent[UserControl].((vm:QueueViewModel)DataContext).IgnoreText}" Command="{Binding IgnoreCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" TextWrapping="Wrap" Foreground="{DynamicResource Trust.Degraded.Brush}" Margin="0,8,0,0" />
        <views:OperationListView />
    </DockPanel>
</UserControl>
