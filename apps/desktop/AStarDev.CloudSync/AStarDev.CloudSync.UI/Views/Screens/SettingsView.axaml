<UserControl xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:vm="using:AStarDev.CloudSync.UI.ViewModels"
                xmlns:views="using:AStarDev.CloudSync.UI.Views"
                xmlns:screens="using:AStarDev.CloudSync.UI.ViewModels.Screens"
                xmlns:loc="using:AStarDev.CloudSync.UI.Localisation"
                xmlns:sys="using:System"
                x:Class="AStarDev.CloudSync.UI.Views.Screens.SettingsView"
                x:DataType="screens:SettingsViewModel">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary.Brush}" Margin="0,0,0,8" />
        <ListBox DockPanel.Dock="Left" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" Background="{DynamicResource Settings.Category.Brush}" MinWidth="160" Margin="0,0,16,0">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SettingsCategoryViewModel">
                    <TextBlock Text="{Binding Title}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,8,0,0" Orientation="Horizontal">
            <Button Content="{loc:Loc Settings.Save}" Command="{Binding SaveCommand}" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Trust.Critical.Brush}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </StackPanel>
        <ScrollViewer>
            <Panel>
                <StackPanel Spacing="8" IsVisible="{Binding IsGeneral}">
                    <TextBlock Text="{loc:Loc Settings.General.Heading}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{loc:Loc Settings.General.Language}" />
                    <TextBlock Text="{loc:Loc Settings.General.LanguageNote}" Foreground="{DynamicResource Text.Secondary.Brush}" TextWrapping="Wrap" />
                    <TextBlock Text="{loc:Loc Settings.Retention.Heading}" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,0" />
                    <TextBlock Text="{loc:Loc Settings.Retention.Audit}" />
                    <NumericUpDown Value="{Binding AuditRetentionDays, Mode=TwoWay}" Minimum="1" Increment="1" FormatString="0" HorizontalAlignment="Left" Width="160" />
                    <TextBlock Text="{loc:Loc Settings.Retention.Telemetry}" />
                    <NumericUpDown Value="{Binding TelemetryRetentionDays, Mode=TwoWay}" Minimum="1" Increment="1" FormatString="0" HorizontalAlignment="Left" Width="160" />
                </StackPanel>
                <StackPanel Spacing="8" IsVisible="{Binding IsProviders}">
                    <TextBlock Text="{loc:Loc Settings.Providers.Heading}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{loc:Loc Settings.Providers.Description}" TextWrapping="Wrap" />
                    <Button Content="{loc:Loc Settings.Providers.Open}" Command="{Binding OpenProvidersCommand}" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel Spacing="8" IsVisible="{Binding IsSynchronisation}">
                    <TextBlock Text="{loc:Loc Settings.Synchronisation.Heading}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding AccountName}" FontWeight="SemiBold" />
                    <TextBlock Text="{loc:Loc Settings.Synchronisation.Description}" TextWrapping="Wrap" />
                    <TextBlock Text="{loc:Loc Common.RemoteFolders}" FontWeight="SemiBold" />
                    <views:FolderTreeView DataContext="{Binding Folders}" />
                    <TextBlock Text="{loc:Loc Settings.Synchronisation.NotSynced}" FontWeight="SemiBold" IsVisible="{Binding Selection.HasUnsyncedFolders}" />
                    <ItemsControl ItemsSource="{Binding Selection.UnsyncedFolders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sys:String">
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                    <Button Content="{loc:Loc Settings.Synchronisation.AddFolder}"
                                            Command="{Binding $parent[UserControl].((screens:SettingsViewModel)DataContext).Selection.AddUnsyncedFolderCommand}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{loc:Loc Common.LocalFolder}" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Text="{Binding Selection.LocalRoot, Mode=TwoWay}" IsReadOnly="{Binding Selection.HasJob}" Width="360" PlaceholderText="{loc:Loc Common.LocalFolderExample}" />
                        <Button Content="{loc:Loc Common.Browse}" Command="{Binding Selection.BrowseCommand}" IsEnabled="{Binding !Selection.HasJob}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{loc:Loc Common.FirstSync}" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding Selection.BootstrapModes}" SelectedItem="{Binding Selection.BootstrapMode, Mode=TwoWay}" IsEnabled="{Binding !Selection.HasJob}" />
                        <Button Content="{loc:Loc Common.CreateSyncJob}" Command="{Binding Selection.CreateJobCommand}" IsEnabled="{Binding Selection.CanCreateJob}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Selection.JobSummary}" />
                    <TextBlock Text="{loc:Loc Settings.Synchronisation.Concurrency}" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBlock Text="{loc:Loc Settings.Synchronisation.ConcurrencyNote}" Foreground="{DynamicResource Text.Secondary.Brush}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Slider Value="{Binding ConcurrencyPosition, Mode=TwoWay}" Minimum="0" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight" IsEnabled="{Binding HasAccount}" Width="240" />
                        <TextBlock Text="{Binding ConcurrencyText}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Selection.StatusMessage}" Foreground="{DynamicResource Trust.Critical.Brush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="8" IsVisible="{Binding IsAppearance}">
                    <TextBlock Text="{loc:Loc Settings.Appearance.Heading}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{loc:Loc Settings.Appearance.Theme}" />
                    <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Spacing="8" IsVisible="{Binding IsNotifications}">
                    <TextBlock Text="{loc:Loc Settings.Notifications.Heading}" FontSize="18" FontWeight="SemiBold" />
                    <CheckBox Content="{loc:Loc Settings.Notifications.Conflicts}" IsChecked="{Binding NotifyOnConflict, Mode=TwoWay}" />
                    <CheckBox Content="{loc:Loc Settings.Notifications.Errors}" IsChecked="{Binding NotifyOnError, Mode=TwoWay}" />
                    <CheckBox Content="{loc:Loc Settings.Notifications.Completion}" IsChecked="{Binding NotifyOnCompletion, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Spacing="8" IsVisible="{Binding IsAdvanced}">
                    <TextBlock Text="{Binding AdvancedHeading}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{loc:Loc Settings.Advanced.Description}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Advanced}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DestinationViewModel">
                                <Button Content="{Binding Title}"
                                        Command="{Binding $parent[UserControl].((screens:SettingsViewModel)DataContext).OpenAdvancedCommand}"
                                        CommandParameter="{Binding Id}"
                                        Margin="0,0,0,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{loc:Loc Settings.Daemon.Heading}" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,0" />
                    <TextBlock Text="{loc:Loc Settings.Daemon.Description}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{loc:Loc Settings.Daemon.Stop}" Command="{Binding RequestStopDaemonCommand}" />
                        <Button Content="{loc:Loc Settings.Daemon.Restart}" Command="{Binding RequestRestartDaemonCommand}" />
                    </StackPanel>
                    <StackPanel Spacing="8" IsVisible="{Binding IsDaemonConfirmationShown}">
                        <TextBlock Text="{Binding DaemonConfirmationText}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{loc:Loc Settings.Daemon.Confirm}" Command="{Binding ConfirmDaemonRequestCommand}" />
                            <Button Content="{loc:Loc Settings.Daemon.Cancel}" Command="{Binding CancelDaemonRequestCommand}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Panel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
