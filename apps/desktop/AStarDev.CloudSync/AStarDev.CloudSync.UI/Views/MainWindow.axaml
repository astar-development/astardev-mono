<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AStarDev.CloudSync.UI.ViewModels"
        xmlns:views="using:AStarDev.CloudSync.UI.Views"
        xmlns:loc="using:AStarDev.CloudSync.UI.Localisation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AStarDev.CloudSync.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Background="{DynamicResource Surface.Brush}"
        Title="{loc:Loc Common.AppTitle}">

    <Panel>
    <DockPanel>
        <views:StatusBarView DockPanel.Dock="Bottom" DataContext="{Binding StatusBar}" />
        <ListBox DockPanel.Dock="Left" ItemsSource="{Binding Destinations}" SelectedItem="{Binding SelectedDestination, Mode=TwoWay}" Background="{DynamicResource Navigation.Rail.Brush}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:DestinationViewModel">
                    <TextBlock Text="{Binding Glyph}" FontSize="22" HorizontalAlignment="Center" ToolTip.Tip="{Binding Title}" AutomationProperties.Name="{Binding Title}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <ContentControl Content="{Binding Content}" />
    </DockPanel>
    <ContentControl Content="{Binding Onboarding}" IsVisible="{Binding Onboarding.IsActive}" />
    </Panel>

</Window>
