<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AStarDev.CloudSync.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AStarDev.CloudSync.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="AStarDev.CloudSync">

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="8" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
            <TextBlock Text="{Binding Connection.StatusText}" />
        </Border>
        <StackPanel Margin="16" Spacing="8">
            <Button Content="Connect OneDrive" Command="{Binding Connect.ConnectCommand}" HorizontalAlignment="Left" />
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Connect.IsBusy}">
                <ProgressBar IsIndeterminate="True" Width="120" />
                <TextBlock Text="Waiting for sign-in in your browser..." />
            </StackPanel>
            <TextBlock Text="{Binding Connect.ItemCountText}" />
            <TextBlock Text="{Binding Connect.ErrorMessage}" Foreground="Red" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding Accounts.Accounts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AccountCardViewModel">
                        <Border BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" Padding="8" Margin="0,0,0,8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding StatusText}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Reconnect" Command="{Binding ReconnectCommand}" IsVisible="{Binding CanReconnect}" />
                                    <Button Content="Disconnect" Command="{Binding DisconnectCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Accounts.ErrorMessage}" Foreground="Red" TextWrapping="Wrap" />
            <TextBlock Text="Remote folders" FontWeight="SemiBold" />
            <TreeView ItemsSource="{Binding Folders.Roots}" MaxHeight="400">
                <TreeView.Styles>
                    <Style Selector="TreeViewItem" x:DataType="vm:FolderNodeViewModel">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    </Style>
                </TreeView.Styles>
                <TreeView.ItemTemplate>
                    <TreeDataTemplate x:DataType="vm:FolderNodeViewModel" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsVisible="{Binding CanSelect}" MinWidth="0" Padding="0" />
                            <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                        </StackPanel>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
            <TextBlock Text="Local folder" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Text="{Binding Selection.LocalRoot, Mode=TwoWay}" IsReadOnly="{Binding Selection.HasJob}" Width="360" PlaceholderText="/home/you/OneDrive" />
                <Button Content="Browse..." Command="{Binding Selection.BrowseCommand}" IsEnabled="{Binding !Selection.HasJob}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="First sync" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding Selection.BootstrapModes}" SelectedItem="{Binding Selection.BootstrapMode, Mode=TwoWay}" IsEnabled="{Binding !Selection.HasJob}" />
                <Button Content="Create sync job" Command="{Binding Selection.CreateJobCommand}" IsEnabled="{Binding Selection.CanCreateJob}" />
            </StackPanel>
            <TextBlock Text="{Binding Selection.JobSummary}" />
            <TextBlock Text="{Binding Selection.StatusMessage}" Foreground="Red" TextWrapping="Wrap" />
        </StackPanel>
    </DockPanel>

</Window>
