<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AStarDev.CloudSync.UI.ViewModels"
             x:Class="AStarDev.CloudSync.UI.Views.FolderTreeView"
             x:DataType="vm:FolderTreeViewModel">
    <TreeView ItemsSource="{Binding Roots}" MaxHeight="400">
        <TreeView.Styles>
            <Style Selector="TreeViewItem" x:DataType="vm:FolderNodeViewModel">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            </Style>
        </TreeView.Styles>
        <TreeView.ItemTemplate>
            <TreeDataTemplate x:DataType="vm:FolderNodeViewModel" ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsVisible="{Binding CanSelect}" MinWidth="0" Padding="0" />
                    <TextBlock Text="{Binding Text}" IsVisible="{Binding !IsMore}" VerticalAlignment="Center" />
                    <Button Content="{Binding Text}" Command="{Binding LoadMoreCommand}" IsVisible="{Binding IsMore}" />
                </StackPanel>
            </TreeDataTemplate>
        </TreeView.ItemTemplate>
    </TreeView>
</UserControl>
