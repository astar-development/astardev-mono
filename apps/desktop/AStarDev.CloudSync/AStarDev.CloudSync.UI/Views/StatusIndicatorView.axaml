<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AStarDev.CloudSync.UI.ViewModels"
             x:Class="AStarDev.CloudSync.UI.Views.StatusIndicatorView"
             x:DataType="vm:StatusIndicatorViewModel">
    <StackPanel Orientation="Horizontal" Spacing="6">
        <Path x:Name="Icon" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
        <TextBlock x:Name="Label" Text="{Binding Text}" VerticalAlignment="Center" />
    </StackPanel>
</UserControl>
