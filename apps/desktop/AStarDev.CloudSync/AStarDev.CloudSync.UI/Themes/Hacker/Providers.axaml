  <SolidColorBrush x:Key="Providers.Health.AuthenticationRequired.Brush" Color="#FF9100" />
  <SolidColorBrush x:Key="Providers.Health.Offline.Brush" Color="#4D6B4D" />
  <SolidColorBrush x:Key="Providers.Card.Brush" Color="#0A120A" />
  <SolidColorBrush x:Key="Providers.Banner.Brush" Color="#1F1500" />
