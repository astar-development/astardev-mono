  <SolidColorBrush x:Key="Providers.Health.AuthenticationRequired.Brush" Color="#FF8FAB" />
  <SolidColorBrush x:Key="Providers.Health.Offline.Brush" Color="#A99BC0" />
  <SolidColorBrush x:Key="Providers.Card.Brush" Color="#2A1647" />
  <SolidColorBrush x:Key="Providers.Banner.Brush" Color="#3F1F3A" />
