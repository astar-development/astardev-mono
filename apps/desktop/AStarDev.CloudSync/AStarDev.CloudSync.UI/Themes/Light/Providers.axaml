  <SolidColorBrush x:Key="Providers.Health.Warning.Brush" Color="#B26A00" />
  <SolidColorBrush x:Key="Providers.Health.Error.Brush" Color="#C62828" />
  <SolidColorBrush x:Key="Providers.Health.AuthenticationRequired.Brush" Color="#D84315" />
  <SolidColorBrush x:Key="Providers.Health.Offline.Brush" Color="#757575" />
  <SolidColorBrush x:Key="Providers.Card.Brush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Providers.Banner.Brush" Color="#FDE7DC" />
