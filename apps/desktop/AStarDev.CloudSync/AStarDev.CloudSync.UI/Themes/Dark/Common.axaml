<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Trust.Healthy.Brush" Color="#4CAF50" />
  <SolidColorBrush x:Key="Trust.Active.Brush" Color="#42A5F5" />
  <SolidColorBrush x:Key="Trust.Degraded.Brush" Color="#FFB300" />
  <SolidColorBrush x:Key="Trust.Attention.Brush" Color="#FF7043" />
  <SolidColorBrush x:Key="Trust.Critical.Brush" Color="#EF5350" />
  <SolidColorBrush x:Key="Surface.Brush" Color="#14171C" />
  <SolidColorBrush x:Key="Surface.Raised.Brush" Color="#1B2028" />
  <SolidColorBrush x:Key="Border.Brush" Color="#3A424F" />
  <SolidColorBrush x:Key="Text.Primary.Brush" Color="#F0F2F5" />
  <SolidColorBrush x:Key="Text.Secondary.Brush" Color="#9AA3AF" />
  <SolidColorBrush x:Key="Accent.Brush" Color="#3B82F6" />
</ResourceDictionary>
