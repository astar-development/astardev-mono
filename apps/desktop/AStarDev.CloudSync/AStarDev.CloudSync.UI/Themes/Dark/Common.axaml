<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Trust.Healthy.Brush" Color="#4CAF50" />
  <SolidColorBrush x:Key="Trust.Active.Brush" Color="#42A5F5" />
  <SolidColorBrush x:Key="Trust.Degraded.Brush" Color="#FFB300" />
  <SolidColorBrush x:Key="Trust.Attention.Brush" Color="#FF7043" />
  <SolidColorBrush x:Key="Trust.Critical.Brush" Color="#EF5350" />
  <SolidColorBrush x:Key="Surface.Brush" Color="#1E1E1E" />
  <SolidColorBrush x:Key="Surface.Raised.Brush" Color="#2B2B2B" />
  <SolidColorBrush x:Key="Border.Brush" Color="#3C3C3C" />
  <SolidColorBrush x:Key="Text.Primary.Brush" Color="#EDEDED" />
  <SolidColorBrush x:Key="Text.Secondary.Brush" Color="#A0A0A0" />
</ResourceDictionary>
